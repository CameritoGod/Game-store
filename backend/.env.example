# ==============================================================================
# GAMESTORE - BACKEND ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================

# Puerto del Servidor HTTP Express
PORT=5000

# URL de Origen Permitido para CORS (Frontend)
FRONTEND_URL=http://localhost:5173

# Credenciales de API Externa Twitch / IGDB (https://api-docs.igdb.com)
IGDB_CLIENT_ID=tu_client_id_de_twitch
IGDB_CLIENT_SECRET=tu_client_secret_de_twitch
IGDB_TOKEN_URL=https://id.twitch.tv/oauth2/token
IGDB_API_URL=https://api.igdb.com/v4

# Conexión a Base de Datos MySQL
DB_HOST=127.0.0.1
DB_USER=root
DB_PASSWORD=
DB_NAME=game_store_v2
DB_PORT=3306

# Llave Secreta para Firma y Verificación de Tokens JWT
JWT_SECRET=123456

# Credenciales SMTP de Gmail para Recuperación de Contraseña (Nodemailer)
EMAIL_USER=tu_correo@gmail.com
EMAIL_PASS=tu_app_password_de_16_caracteres

# Credenciales de Semilla Administrador (npm run seed)
ADMIN_EMAIL=admin@gamestore.com
ADMIN_PASSWORD=Admin123!
ADMIN_NICKNAME=admin
ADMIN_NOMBRE=Administrador Principal
